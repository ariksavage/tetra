<?php
/**
 * Migration: Seed Tetra's configuration (superseded)
 *
 * This used to write Tetra's application settings (name, copyright, session
 * and password reset lengths) into the config table with their defaults.
 * Since 2026-11-13 those come from the app's tetra.json and Tetra's schema
 * (tetra.schema.json); a config row now means "this site overrides it", so
 * seeding rows would override every app's tetra.json with "App". It does
 * nothing now. Sites that already ran it have their rows tidied by
 * ClearConfigMatchingTetraJson.
 *
 * PHP version 8.4
 *
 * @category   Migration
 * @package    Tetra
 * @author     Arik Savage <ariksavage@gmail.com>
 * @since      2026-11-11
 */

namespace Core\Migrations;

class SeedTetraConfig extends \Core\Migrations\Models\Migration
{
  public string $name = 'Seed Tetra configuration (superseded by tetra.json)';

  protected function isComplete(): bool
  {
    return TRUE;
  }

  protected function execute(): bool
  {
    return TRUE;
  }
}
