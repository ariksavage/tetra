RewriteEngine On

# Pages come from index.php (the page renderer), which fills in the built
# index.html's head for each URL, so crawlers that don't run JavaScript get
# each page's title and metadata.
DirectoryIndex index.php

# The only PHP reached over the web is index.php (the API). Everything else,
# such as cli/maintenance.php or a class file, is for PHP itself to include.
<FilesMatch "\.php$">
  Require all denied
</FilesMatch>
<Files "index.php">
  Require all granted
</Files>

# Nor any file whose name starts with a dot (eg. .user.ini, an app's PHP
# settings). Apache's own default only covers .ht* files. Folders such as
# /.well-known/ (certificate checks) aren't affected.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Do not rewrite anything under /images
RewriteRule ^images/ - [L]

# The bare shell is never served directly: a request for it is a page too.
RewriteRule ^index\.html$ index.php [L]

# Serve existing files or directories as-is
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Skip index.php itself
RewriteRule ^(core/)?index\.php$ - [END]

# API routing: requires /core prefix, 1-4 segments
RewriteRule ^core/([^/]+)(?:/([^/]+))?(?:/([^/]+))?(?:/([^/]+))?/?$ index.php?apitype=$1&action=$2&id=$3&id2=$4 [QSA,L,NC]

# Anything else is a page: the page renderer (index.php, no apitype)
RewriteRule ^ index.php [L]

# --- Performance ---

# Compress text responses. Declaring this here replaces the server's default list
# for this site, so every type has to be named, not just the API's JSON.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Recipe images: a new upload always gets a new file name, so these can be kept a long time.
  <FilesMatch "\.(webp|jpe?g|png|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # Build output with a content hash in the name never changes.
  <FilesMatch "^(main|polyfills|styles|chunk)-[A-Za-z0-9_-]+\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # The editor's files keep the same names between versions, so cache them for a week only.
  <If "%{REQUEST_URI} =~ m#^/tinymce/.*\.(js|css)$#">
    Header set Cache-Control "public, max-age=604800"
  </If>

  # The page shell must always be checked, so a new deploy is picked up straight away.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
